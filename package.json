{
  "name": "portfoliodb-dashboard-frontend",
  "private": true,
  "description": "Build, lint and test tooling for the dashboard front end in app/dashboard/static. Nothing here runs in production: the built app.js/app.css are committed and read by app/streamlit_app.py.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node app/dashboard/static/build.mjs",
    "build:check": "node app/dashboard/static/build.mjs --check",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --import ./app/dashboard/static/tests/json-hook.mjs --test --test-reporter=spec \"app/dashboard/static/tests/*.test.mjs\"",
    "ci": "npm run build:check && npm run lint && npm test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1"
  }
}
