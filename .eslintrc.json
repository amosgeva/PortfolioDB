{
  "//": "Read by Codacy's ESLint 8 only (its 'use configuration file' mode needs an eslintrc). The project's own lint is eslint.config.mjs (ESLint 10, run by frontend.yml); keep the rules here in step with it.",
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "extends": "eslint:recommended",
  "ignorePatterns": ["archive/", "node_modules/", "app/dashboard/static/app.js"],
  "globals": { "DATA": "readonly" },
  "rules": {
    "no-restricted-syntax": ["error",
      { "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.name=/^(innerHTML|outerHTML)$/]", "message": "Write markup with setHTML(el, html`...`) from core/html.js." },
      { "selector": "CallExpression[callee.property.name='insertAdjacentHTML']", "message": "insertAdjacentHTML bypasses the escaping template." },
      { "selector": "CallExpression[callee.object.name='document'][callee.property.name=/^(write|writeln)$/]", "message": "document.write bypasses the escaping template." },
      { "selector": "CallExpression[callee.property.name='createContextualFragment']", "message": "createContextualFragment parses markup without escaping." },
      { "selector": "CallExpression[callee.property.name='parseFromString']", "message": "DOMParser.parseFromString parses markup without escaping." },
      { "selector": "CallExpression[callee.name='html']", "message": "html must be a tagged template (html`...`)." },
      { "selector": "CallExpression[callee.property.name='setAttribute'][arguments.0.type='Literal'][arguments.0.value=/^on/i]", "message": "No inline event-handler attributes." },
      { "selector": "CallExpression[callee.property.name='setAttribute'][arguments.0.type!='Literal']", "message": "Name the attribute literally." },
      { "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.name=/^on[a-z]+$/]", "message": "No on* property handlers." },
      { "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.name='srcdoc']", "message": "srcdoc is a markup sink." }
    ],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }]
  },
  "overrides": [
    {
      "files": ["app/dashboard/static/build.mjs", "app/dashboard/static/tests/**/*.mjs", "eslint.config.mjs"],
      "env": { "browser": false, "node": true },
      "rules": { "no-restricted-syntax": "off" }
    }
  ]
}
