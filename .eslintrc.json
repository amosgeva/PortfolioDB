{
  "root": true,
  "noInlineConfig": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    "archive/",
    "node_modules/",
    "app/dashboard/static/app.js"
  ],
  "globals": {
    "DATA": "readonly"
  },
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[property.name=/^(innerHTML|outerHTML|srcdoc|insertAdjacentHTML|insertAdjacentElement|createContextualFragment|parseFromString|write|writeln|setAttributeNS|setAttributeNode|setHTMLUnsafe|execCommand|__defineSetter__|__lookupSetter__|__proto__)$/]",
        "message": "Markup sinks are reached only through setHTML(el, html`...`) from core/html.js."
      },
      {
        "selector": "MemberExpression[computed=true][property.value=/^(innerHTML|outerHTML|srcdoc|insertAdjacentHTML|insertAdjacentElement|createContextualFragment|parseFromString|write|writeln|setAttributeNS|setAttributeNode|setHTMLUnsafe|execCommand|__defineSetter__|__lookupSetter__|__proto__|on.*)$/i]",
        "message": "A computed reference to a markup or event-handler property is still a sink."
      },
      {
        "selector": "MemberExpression[computed=true]",
        "message": "No computed member access (read, write or call): a key held in a variable can name a sink. Use item()/put() from core/dict.js, Map, or Array#at."
      },
      {
        "selector": "AssignmentExpression > MemberExpression.left[property.name=/^on[a-z]+$/i]",
        "message": "No on* property handlers; use addEventListener."
      },
      {
        "selector": "CallExpression[callee.property.name='setAttribute'][arguments.0.type='Literal'][arguments.0.value=/^(on.*|srcdoc|formaction)$/i]",
        "message": "No event-handler, srcdoc or formaction attributes."
      },
      {
        "selector": "CallExpression[callee.property.name='setAttribute'][arguments.0.type!='Literal']",
        "message": "setAttribute with a computed name could set an event handler. Name the attribute literally."
      },
      {
        "selector": "Property[computed=true]",
        "message": "No computed object keys: { [k]: v } can carry innerHTML into Object.assign or a spread."
      },
      {
        "selector": "Property[key.name=/^(innerHTML|outerHTML|srcdoc|insertAdjacentHTML|insertAdjacentElement|createContextualFragment|parseFromString|write|writeln|setAttributeNS|setAttributeNode|setHTMLUnsafe|execCommand|__defineSetter__|__lookupSetter__|__proto__)$/], Property[key.value=/^(innerHTML|outerHTML|srcdoc|insertAdjacentHTML|insertAdjacentElement|createContextualFragment|parseFromString|write|writeln|setAttributeNS|setAttributeNode|setHTMLUnsafe|execCommand|__defineSetter__|__lookupSetter__|__proto__|on.*)$/i]",
        "message": "An object key naming a markup sink or handler can be copied onto an element."
      },
      {
        "selector": "Identifier[name='Reflect']",
        "message": "Reflect can reach any property by name."
      },
      {
        "selector": "MemberExpression[object.name='Object'][property.name=/^(assign|defineProperty|defineProperties|setPrototypeOf|getOwnPropertyDescriptor|getOwnPropertyDescriptors)$/]",
        "message": "Object.assign/defineProperty/descriptors can copy a markup property or setter onto an element."
      },
      {
        "selector": "MemberExpression[property.name=/^(prototype|constructor)$/]",
        "message": "No prototype or constructor access: Element.prototype descriptors are a route to innerHTML."
      },
      {
        "selector": "Identifier[name='html']:not(TaggedTemplateExpression > Identifier.tag):not(ImportSpecifier > Identifier)",
        "message": "html may only be used as a tag: html`...`. Calling, storing, passing or shadowing it lets runtime text pose as a template."
      },
      {
        "selector": "ImportSpecifier[imported.type='Literal'], ExportSpecifier[local.type='Literal'], ExportSpecifier[exported.type='Literal']",
        "message": "No string-literal import or export names: they hide which binding is which from every check."
      },
      {
        "selector": "ImportSpecifier[imported.name='html'][local.name!='html']",
        "message": "Import html under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='setHTML'][local.name!='setHTML']",
        "message": "Import setHTML under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='attrs'][local.name!='attrs']",
        "message": "Import attrs under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='safeUrl'][local.name!='safeUrl']",
        "message": "Import safeUrl under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='esc'][local.name!='esc']",
        "message": "Import esc under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='join'][local.name!='join']",
        "message": "Import join under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='isSafe'][local.name!='isSafe']",
        "message": "Import isSafe under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='isSafeUrl'][local.name!='isSafeUrl']",
        "message": "Import isSafeUrl under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportSpecifier[imported.name='isAttrList'][local.name!='isAttrList']",
        "message": "Import isAttrList under its own name, so the checks can see every use."
      },
      {
        "selector": "ImportDeclaration[source.value!=/core\\/html(\\.js)?$/] > ImportSpecifier[local.name=/^(html|setHTML|attrs|safeUrl)$/]",
        "message": "html, setHTML, attrs and safeUrl come from core/html.js only."
      },
      {
        "selector": "ImportDeclaration[source.value=/core\\/html(\\.js)?$/] > ImportNamespaceSpecifier, ImportDeclaration[source.value=/core\\/html(\\.js)?$/] > ImportDefaultSpecifier",
        "message": "No namespace or default import of core/html.js: it would allow html to be called as a property."
      },
      {
        "selector": "ImportExpression, ExportAllDeclaration, ExportSpecifier[local.name=/^(html|setHTML|attrs|safeUrl)$/]",
        "message": "html and friends are imported statically from core/html.js and never re-exported."
      }
    ],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "caughtErrors": "none"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ]
  },
