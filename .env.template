# PortfolioDB runtime env
# Copy to .env and fill values. Keep .env private (it is gitignored).

# Used by docker-compose for the postgres container
POSTGRES_PASSWORD=

# Connection used by every Python entry point
PORTFOLIODB_HOST=127.0.0.1
PORTFOLIODB_PORT=54320
PORTFOLIODB_DB=portfoliodb
PORTFOLIODB_USER=portfoliouser
PORTFOLIODB_PASSWORD=

# ── Optional overrides — normally set from the dashboard's Settings page ──
# (Manage → Settings). Values here act as bootstrap/fallback; a value saved
# in Settings wins.

# Name shown in the dashboard rail footer (empty = "Operator")
PORTFOLIODB_DISPLAY_NAME=

# Reporting timezone (IANA name): the calendar that buckets snapshots into
# "days" for daily series, EOD picks and reports. Empty = default.
PORTFOLIODB_TZ=

# When the price collector runs, in the reporting timezone above. HH:MM, both
# ends inclusive; may wrap past midnight. Days are cron-style (1=Mon).
# Defaults cover US regular hours plus a post-close tail in UTC.
PORTFOLIODB_MARKET_START=
PORTFOLIODB_MARKET_END=
PORTFOLIODB_MARKET_WEEK=

# ── Advisor LLM ───────────────────────────────────────────────────────────
# Provider / model are normally set from the Settings page too. The API key
# and the base URL MUST live here: secrets are never stored in the database,
# and the base URL is where the key gets sent, so it is not settable from a
# page that has no login. See docs/llm-providers.md for per-provider examples.
#   LLM_PROVIDER: anthropic | openai | openrouter | ollama | custom
LLM_PROVIDER=
LLM_MODEL=
# Only needed to point a provider somewhere other than its default (a proxy,
# Ollama on the Docker host: http://host.docker.internal:11434/v1). A vendor's
# named key below only travels to that vendor's own origin; anywhere else gets
# LLM_API_KEY.
LLM_BASE_URL=
# Generic key, used by whichever provider is active…
LLM_API_KEY=
# …or the provider-specific names also work:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Financial Datasets (used by fd_weekly_enrichment.py; optional)
FINANCIAL_DATASETS_API_KEY=

# ── Optional MCP server (docker compose --profile mcp) ────────────────────
# Bearer token clients must send. `make init` generates one; set it by hand if
# you started from this template directly. Keep the line even when unused —
# compose warns on every command about variables it cannot resolve.
PORTFOLIODB_MCP_TOKEN=
# Read-only database role for the MCP server (create it with
# sql/create_ro_role.sql, or `make ro-role PASSWORD=...`). Recommended: it makes
# "read-only" a property of the database rather than a promise of the code.
PORTFOLIODB_MCP_RO_USER=
PORTFOLIODB_MCP_RO_PASSWORD=

# ── Optional pgAdmin (docker compose --profile tools) ─────────────────────
PGADMIN_PASSWORD=
PGADMIN_EMAIL=
