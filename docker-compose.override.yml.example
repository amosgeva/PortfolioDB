# Copy to docker-compose.override.yml (gitignored) for anything specific to
# your machine. Compose merges it over docker-compose.yml automatically, so you
# never have to edit the committed file and fight it on every `git pull`.
#
# Copying this file as it stands changes where the database lives and nothing
# else. In particular it does not widen network exposure: every port stays on
# 127.0.0.1 until you uncomment the block at the bottom.

services:
  postgres:
    volumes:
      # Keep the database in a directory you can see and back up with ordinary
      # file tools instead of the default `pgdata` named volume. This is also
      # the migration path for installs that predate the named volume: point
      # this at the directory you already have.
      #
      # Careful: Postgres owns everything under it. Do not edit or move files
      # in there while the container is running.
      - ./data:/var/lib/postgresql/data

  # ── Opt-in: reach the dashboard from other machines on your LAN ──────────
  # The dashboard's read-only views have no login, and its write pages share
  # one password (PORTFOLIODB_DASHBOARD_PASSWORD), so read docs/exposure.md first — a tunnel or an authenticating proxy is safer
  # than this. If you still want it, uncomment the three lines below.
  #
  # `!override` matters: without it Compose *adds* this entry next to the base
  # file's loopback one instead of replacing it. Needs Compose 2.24.4 or newer.
  #
  # dashboard:
  #   ports: !override
  #     - "8501:8501"
