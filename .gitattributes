# Files that are read by Linux tooling inside the container must keep LF even
# when checked out on Windows: a CRLF crontab confuses cron parsers, and a
# CRLF shell script fails with "bad interpreter: /bin/sh^M".
docker/crontab   text eol=lf
Makefile         text eol=lf
*.sh             text eol=lf
Dockerfile       text eol=lf
*.sql            text eol=lf
